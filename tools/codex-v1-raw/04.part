odel?: string\n  signal?: AbortSignal\n  onDelta(text: string): void\n  onToolRequest(call: AgentToolCall): Promise<AgentToolResult>\n  onActivity?(): void\n}\n\nexport interface CodexTurnHandle {\n  threadId: string\n  turnId: string\n}\n\nexport interface CodexDynamicTool {\n  type: 'function'\n  name: string\n  description: string\n  inputSchema: Record<string, unknown>\n}\n",
  "packages/codex-bridge/tests/protocol.test.ts": "import { describe, expect, it } from 'vitest'\nimport { agentToolsToCodex, serializeAgentHistory } from '../src/index'\n\ndescribe('codex bridge protocol mapping', () => {\n  it('maps GenOffice tools to Codex dynamic tools without changing the schema', () => {\n    expect(\n      agentToolsToCodex([\n        {\n          name: 'replace_text',\n          description: 'Replace text in the document',\n          inputSchema: {\n            type: 'object',\n            properties: { text: { type: 'string' } },\n            required: ['text'],\n          },\n        },\n      ]),\n    ).toEqual([\n      {\n        type: 'function',\n        name: 'replace_text',\n        description: 'Replace text in the document',\n        inputSchema: {\n          type: 'object',\n          properties: { text: { type: 'string' } },\n          required: ['text'],\n        },\n      },\n    ])\n  })\n\n  it('serializes GenOffice-owned history into one ephemeral Codex turn', () => {\n    const transcript = serializeAgentHistory([\n      { role: 'user', text: 'Polish this paragraph.' },\n      {\n        role: 'assistant',\n        text: '',\n        toolCalls: [{ id: '1', name: 'replace_text', input: { text: 'Rewritten' } }],\n      },\n      {\n        role: 'tool',\n        results: [{ id: '1', name: 'replace_text', output: 'ok' }],\n      },\n      { role: 'user', text: 'Make it shorter.' },\n    ])\n    expect(transcript).toContain('USER:\\nPolish this paragraph.')\n    expect(transcript).toContain('replace_text: {\"text\":\"Rewritten\"}')\n    expect(transcript).toContain('TOOL RESULTS:\\nreplace_text: ok')\n    expect(transcript).toContain('USER:\\nMake it shorter.')\n  })\n})\n",
  "packages/codex-bridge/tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"types\": [\"node\"]\n  },\n  \"include\": [\"src\", \"tests\"]\n}\n"
}
for (const [rel, content] of Object.entries(embeddedOverlay)) {
  const out = join(target, rel)
  mkdirSync(dirname(out), { recursive: true })
  writeFileSync(out, content)
}

// 2) Workspace scripts / package dependency.
patchJson('package.json', (pkg) => {
  // Pin the Codex CLI version whose app-server protocol this V1 was adapted against.
  // A project-local binary avoids changing the user's global Codex installation.
  pkg.devDependencies ??= {}
  pkg.devDependencies['@openai/codex'] = '0.146.0'
  for (const key of ['test', 'typecheck']) {
    if (typeof pkg.scripts?.[key] !== 'string') continue
    const marker = key === 'test'
      ? 'npm run test -w @genoffice/agent-core &&'
      : 'npm run typecheck -w @genoffice/agent-core &&'
    const add = key === 'test'
      ? `${marker} npm run test -w @genoffice/codex-bridge &&`
      : `${marker} npm run typecheck -w @genoffice/codex-bridge &&`
    if (!pkg.scripts[key].includes('@genoffice/codex-bridge')) {
      if (!pkg.scripts[key].includes(marker)) die(`Could not extend root ${key} script`)
      pkg.scripts[key] = pkg.scripts[key].replace(marker, add)
    }
  }
})

patchJson('apps/docs/package.json', (pkg) => {
  pkg.devDependencies ??= {}
  pkg.devDependencies['@genoffice/codex-bridge'] = '*'
})

// 3) AgentTransport: allow a provider/runtime (Codex) to request a local Office tool
//    *during* a model turn, instead of only emitting tool calls at end-of-turn.
{
  let text = read('packages/agent-core/src/types.ts')
  if (!text.includes('onToolRequest?(')) {
    text = replaceOnce(
      text,
      `  onToolCall(call: AgentToolCall): void\n  /** Phase changes within the model stream (thinking / responding / tool-input); older transports may omit this */`,
      `  onToolCall(call: AgentToolCall): void\n  /** Runtime-managed tool request (e.g. Codex app-server dynamic tools). The transport waits for this result before the same model turn continues. */\n  onToolRequest?(call: AgentToolCall): Promise<AgentToolResult>\n  /** Phase changes within the model stream (thinking / responding / tool-input); older transports may omit this */`,
      'agent callbacks: onToolRequest',
    )
  }
  write('packages/agent-core/src/types.ts', text)
}

{
  let text = read('packages/agent-core/src/electron-transport.ts')
  if (!text.includes("'tool-request'")) {
    text = replaceOnce(
      text,
      `  AgentToolCall,\n  AgentToolDef,\n  AgentTransport,`,
      `  AgentToolCall,\n  AgentToolDef,\n  AgentToolResult,\n  AgentTransport,`,
      'electron transport AgentToolResult import',
    )
    text = replaceOnce(
      text,
      `  type: 'delta' | 'tool-call' | 'done' | 'error' | 'ping'\n  text?: string\n  toolCall?: AgentToolCall`,
      `  type: 'delta' | 'tool-call' | 'tool-request' | 'done' | 'error' | 'ping'\n  text?: string\n  toolCall?: AgentToolCall\n  /** Correlates a Codex server-side dynamic tool request with the result sent back over IPC. */\n  toolRequestId?: string`,
      'electron stream chunk tool-request',
    )
    text = replaceOnce(
      text,
      `  /** abort the in-flight turn in the main process */\n  cancel(requestId: string): void\n  getSettings(): S`,
      `  /** abort the in-flight turn in the main process */\n  cancel(requestId: string): void\n  /** Return a runtime-managed local tool result to the main process. Optional for legacy providers. */\n  respondTool?(requestId: string, toolRequestId: string, result: AgentToolResult): void | Promise<unknown>\n  getSettings(): S`,
      'electron transport respondTool option',
    )
    text = replaceOnce(
      text,
      `        } else if (chunk.type === 'done') {\n          settle()`,
      `        } else if (chunk.type === 'tool-request') {\n          armSilence()\n          const call = chunk.toolCall\n          const toolRequestId = chunk.toolRequestId\n          if (!call || !toolRequestId || !cb.onToolRequest || !options.respondTool) {\n            fail('This AI runtime requested a local tool, but the renderer bridge is not configured for runtime-managed tools.')\n            return\n          }\n          void cb\n            .onToolRequest(call)\n            .then((result) => options.respondTool!(requestId, toolRequestId, result))\n            .catch((error: unknown) =>\n              options.respondTool!(requestId, toolRequestId, {\n                id: call.id,\n                name: call.name,\n                output: error instanceof Error ? error.message : String(error),\n                isError: true,\n              }),\n            )\n            .catc