 Genspark to Codex.\n  aiGskStatus: (withEmail?: boolean) => ipcRenderer.invoke('ai:codex-status', withEmail),\n  aiGskLogin: () => ipcRenderer.invoke('ai:codex-login'),`,
      'Docs preload Codex account/tool result channels',
    )
  }
  write('apps/docs/src/preload/index.ts', text)
}

