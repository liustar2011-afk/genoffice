      `    const provider = settings.provider\n    if (provider === 'codex') return codexChat(request)\n    let config = settings.providers?.[provider]\n    if (provider === 'genspark' && config && !config.apiKey) {`,
      'Docs main Codex one-shot chat',
    )
  }
  write('apps/docs/src/main/docs-main.ts', text)
}



// 6b) Unified shell renderer bridges: all five editors share the same Docs-registered
//     ai:* main-process runtime, but each renderer has its own preload + AgentTransport.
//     Add the Codex dynamic-tool result return channel to Sheets / Slides / PDF / Markdown.
function patchSharedToolResult(rel, marker, replacement, label) {
  let text = read(rel)
  if (!text.includes('aiStreamToolResult')) {
    text = replaceOnce(text, marker, replacement, label)
  }
  write(rel, text)
}

