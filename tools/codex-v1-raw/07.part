for (const [rel, apiName, label] of [
  ['apps/sheets/src/renderer/ai/transport.ts', 'desktopApi', 'Sheets'],
  ['apps/slides/src/renderer/ai/transport.ts', 'slidesApi', 'Slides'],
  ['apps/pdf/src/renderer/ai/transport.ts', 'pdfApi', 'PDF'],
  ['apps/markdown/src/renderer/ai/transport.ts', 'markdownApi', 'Markdown'],
]) {
  let text = read(rel)
  if (!text.includes('respondTool:')) {
    const before = `    cancel: (requestId) => void window.${apiName}.aiStreamCancel(requestId),\n    getSettings,`
    const after = `    cancel: (requestId) => void window.${apiName}.aiStreamCancel(requestId),\n    respondTool: (requestId, toolRequestId, result) =>\n      window.${apiName}.aiStreamToolResult(requestId, toolRequestId, result),\n    getSettings,`
    text = replaceOnce(text, before, after, `${label} renderer transport respondTool`)
  }
  write(rel, text)
}

// Only change sign-in terminology in apps that expose the legacy account UI. Genspark-specific
// image/media tools keep their own labels because V1 deliberately leaves those external tools intact.
for (const rel of [
  'apps/sheets/src/renderer/i18n/strings-ai.ts',
  'apps/slides/src/renderer/i18n/strings-ai.ts',
]) {
  let text = read(rel)
  text = text.replaceAll('Sign in to Genspark', 'Sign in with ChatGPT')
  text = text.replaceAll('Log in to Genspark', 'Sign in with ChatGPT')
  text = text.replaceAll('登录 Genspark', '使用 ChatGPT 登录')
  text = text.replaceAll('登入 Genspark', '使用 ChatGPT 登入')
  text = text.replaceAll('Genspark account', 'ChatGPT account')
  write(rel, text)
}


