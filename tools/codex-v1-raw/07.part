// 8) Unified shell account UI: reuse existing HomeApi method names but point them at Codex/ChatGPT.
patchJson('apps/shell/package.json', (pkg) => {
  pkg.devDependencies ??= {}
  pkg.devDependencies['@genoffice/codex-bridge'] = '*'
})

